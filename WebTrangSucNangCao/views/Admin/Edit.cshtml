@model WebTrangSucNangCao.Models.ProductEditViewModel
@{
    // Xài ViewData đéo xài ViewBag
    ViewData["Title"] = "Sửa Sản Phẩm";
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-7">
            <h2>Sửa Sản Phẩm: @Model.Product.NamePro</h2>

            <form asp-controller="Admin" asp-action="Edit" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="Product.ProductId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-horizontal">
                    <hr />
                    <div class="form-group mb-3">
                        <label class="control-label col-md-10">Tên sản phẩm</label>
                        <div class="col-md-12">
                            <input asp-for="Product.NamePro" class="form-control" />
                            <span asp-validation-for="Product.NamePro" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label col-md-10">Mô tả</label>
                        <div class="col-md-12">
                            <textarea asp-for="Product.DecriptionPro" rows="5" class="form-control"></textarea>
                            <span asp-validation-for="Product.DecriptionPro" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label col-md-10">Chất liệu</label>
                        <div class="col-md-12">
                            <textarea asp-for="Product.Material" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Product.Material" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label col-md-10">Danh mục</label>
                        <div class="col-md-12">
                            <select asp-for="Product.Category" asp-items="Model.CategoryList" class="form-control">
                                <option value="">--- Chọn danh mục ---</option>
                            </select>
                            <span asp-validation-for="Product.Category" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label col-md-10">Giá</label>
                        <div class="col-md-12">
                            <input asp-for="Product.Price" type="number" class="form-control" />
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="col-md-12 mt-4">
                            <button type="submit" class="btn btn-primary">Lưu Thay Đổi (Chỉ Thông tin)</button>
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-md-5">

            <h4>Ảnh Gallery</h4>
            <p>Ảnh bìa là ảnh đầu tiên trong list này.</p>
            <table class="table table-sm">
                @foreach (var img in Model.Images)
                {
                    <tr>
                        <td><img src="@Url.Content(img.ImagePath)" style="width: 50px; height: 50px; object-fit: cover;" /></td>
                        <td>
                            <form asp-controller="Admin" asp-action="DeleteImage" method="post" class="m-0 p-0">
                                <input type="hidden" name="imageId" value="@img.ImageId" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa ảnh này?')">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
            @* (Code Thêm Ảnh sẽ làm sau) *@

            <hr class="my-4">

            <h4>Quản lý Size / Biến thể</h4>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tên Size</th>
                        <th>Tồn kho</th>
                        <th>Xóa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variant in Model.Variants)
                    {
                        <tr>
                            <td>@variant.VariantName</td>
                            <td>@variant.Stock</td>
                            <td>
                                <form asp-controller="Admin" asp-action="DeleteVariant" method="post" class="m-0 p-0">
                                    <input type="hidden" name="variantId" value="@variant.VariantId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa size này?')">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* FORM THÊM SIZE MỚI *@
            <form asp-controller="Admin" asp-action="AddVariant" method="post">
                <input type="hidden" name="ProductID" value="@Model.Product.ProductId" />

                <div class="input-group">
                    <input type="text" name="VariantName" class="form-control" placeholder="Tên size (ví dụ: S24)" required />
                    <input type="number" name="Stock" class="form-control" placeholder="Số lượng" required />
                    <button type="submit" class="btn btn-success">+</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}