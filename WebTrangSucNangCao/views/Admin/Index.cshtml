@model WebTrangSucNangCao.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1">DASHBOARD QUẢN TRỊ</h2>
        <p class="text-muted mb-0">Chào mừng bạn trở lại, hệ thống tổng hợp thông số thời gian thực.</p>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="AddProduct" class="btn btn-dark fw-bold rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Thêm Sản Phẩm Mới
        </a>
    </div>
</div>

<!-- Architect UI Card Widgets -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="arch-card p-4 h-100 border-start border-4 border-dark">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Doanh Số</span>
                <i class="fas fa-wallet text-dark fs-4"></i>
            </div>
            <h3 class="fw-bold mb-1">@String.Format("{0:N0} VNĐ", Model.TotalRevenue)</h3>
            <span class="badge bg-success-subtle text-success small">Đơn hoàn tất</span>
        </div>
    </div>

    <div class="col-md-3">
        <div class="arch-card p-4 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Đơn Chờ Xử Lý</span>
                <i class="fas fa-clock text-warning fs-4"></i>
            </div>
            <h3 class="fw-bold mb-1">@Model.PendingOrdersCount Đơn</h3>
            @if (Model.PendingOrdersCount > 0)
            {
                <a asp-controller="Admin" asp-action="Orders" asp-route-statusFilter="Đang xử lý" class="small fw-bold text-dark text-decoration-none">
                    Xử lý ngay <i class="fas fa-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <span class="small text-muted">Không có đơn tồn đọng</span>
            }
        </div>
    </div>

    <div class="col-md-3">
        <div class="arch-card p-4 h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Đã Bán Ra</span>
                <i class="fas fa-shopping-cart text-info fs-4"></i>
            </div>
            <h3 class="fw-bold mb-1">@Model.TotalProductsSold SP</h3>
            <span class="small text-muted">Tổng sản phẩm đã giao</span>
        </div>
    </div>

    <div class="col-md-3">
        <div class="arch-card p-4 h-100 border-start border-4 border-secondary">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Kho Sản Phẩm</span>
                <i class="fas fa-box text-secondary fs-4"></i>
            </div>
            <h3 class="fw-bold mb-1">@Model.Products.Count SP</h3>
            <span class="small text-muted">Mã sản phẩm active</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LOW-STOCK ALERT WIDGET WITH QUICK UPDATE MODAL -->
    <div class="col-md-7">
        <div class="arch-card h-100">
            <div class="arch-card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-exclamation-triangle text-warning fs-5"></i>
                    <span>Cảnh Báo Sắp Hết Hàng (Tồn kho &le; 5)</span>
                </div>
                <span class="badge bg-danger">@Model.LowStockVariants.Count item</span>
            </div>
            <div class="p-0">
                @if (Model.LowStockVariants.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản Phẩm</th>
                                    <th>Size / Phiên bản</th>
                                    <th class="text-center">Tồn Kho</th>
                                    <th class="text-end">Cập nhật nhanh</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockVariants)
                                {
                                    <tr id="variant-row-@item.VariantId">
                                        <td class="fw-bold text-dark">
                                            @(item.Product?.NamePro ?? "Sản phẩm #" + item.ProductId)
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@item.VariantName</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger fs-6 px-3 py-2 stock-badge" id="stock-val-@item.VariantId">@item.Stock</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3"
                                                    onclick="openMultiSizeModal(@item.ProductId)">
                                                Quick Update Các Size
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-success">
                        <i class="fas fa-check-circle fs-1 mb-2"></i>
                        <p class="mb-0 fw-semibold">Tất cả sản phẩm đều có số lượng tồn kho an toàn!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- BANNER SLIDER MANAGEMENT WIDGET -->
    <div class="col-md-5">
        <div class="arch-card h-100">
            <div class="arch-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span>Quản Lý Slider</span>
                </div>
            </div>
            <div class="p-4">
                <form asp-controller="Admin" asp-action="AddSlider" method="post" enctype="multipart/form-data" class="row g-2 mb-4">
                    <div class="col-8">
                        <input type="file" name="ImageFile" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold">Thêm Slider</button>
                    </div>
                    <div class="col-12">
                       <input asp-for="NewSlider.Link" class="form-control form-control-sm" placeholder="Link khi bấm (VD: /Home/Rings)" />
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Link</th>
                                <th class="text-center" style="width: 50px;">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slider in Model.Sliders)
                            {
                                <tr>
                                    <td>
                                        <img src="@Url.Content(Url.NormalizeImagePath(slider.ImagePath))" style="height: 40px; width: auto;" />
                                    </td>
                                    <td class="small text-truncate" style="max-width: 140px;">@slider.Link</td>
                                    <td class="text-center">
                                        <form asp-controller="Admin" asp-action="DeleteSlider" asp-route-id="@slider.SliderId" method="post" class="m-0 p-0">
                                            <button type="submit" class="btn btn-danger btn-sm py-0" onclick="return confirm('Xóa banner này?')">&times;</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>