@model WebTrangSucNangCao.Models.OrderPro
@{
    ViewData["Title"] = "Sửa Đơn Hàng";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2>Sửa Trạng Thái Đơn Hàng #@Model.Id</h2>
    <hr />

    <form asp-controller="Admin" asp-action="EditOrder" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label class="form-label">Tên Khách Hàng</label>
            <input type="text" class="form-control"
                   value="@(Model.IdcusNavigation != null ? Model.IdcusNavigation.NameCus : "Khách vãng lai")" readonly />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Địa chỉ Giao</label>
            <input type="text" class="form-control" value="@Model.AddressDeliverry" readonly />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Trạng Thái</label>
            <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-control">
                <option value="">-- Chọn trạng thái --</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-secondary">Quay lại</a>
    </form>
</div>