@model IEnumerable<WebTrangSucNangCao.Models.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col">
            <h2 class="mb-4 border-bottom pb-2">Quản lý Sản phẩm</h2>

            <p class="text-end">
                <a asp-controller="Admin" asp-action="AddProduct" class="btn btn-dark fw-bold">+ Thêm Sản Phẩm Mới</a>
            </p>

            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Giá</th>
                        <th>Danh Mục</th>
                        <th style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="@Url.Content(Url.NormalizeImagePath(item.ImagePro))" style="width: 70px; height: 70px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                            </td>
                            <td class="fw-bold">@item.NamePro</td>
                            <td class="text-end">@String.Format("{0:N0} VNĐ", item.Price)</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">
                                    @item.CategoryNavigation?.NameCate
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.ProductId"
                                   class="btn btn-outline-dark btn-sm" style="background-color: white;">Sửa</a>

                                <button class="btn btn-dark btn-sm ms-1 delete-btn"
                                        data-id="@item.ProductId"
                                        data-name="@item.NamePro"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteConfirmModal"
                                        style="border-radius: 4px;">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* === MODAL XÓA SẢN PHẨM === *@
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc muốn xóa sản phẩm: <strong id="productNameModal" class="text-danger"></strong>?
                <br />
                <small class="text-muted">Hành động này không thể hoàn tác.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>

                <form asp-controller="Admin" asp-action="Delete" method="post">
                    <input type="hidden" name="id" id="deleteProductIdInput" />
                    <button type="submit" class="btn btn-dark">Xác nhận Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var deleteModal = document.getElementById('deleteConfirmModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var productId = button.getAttribute('data-id');
                var productName = button.getAttribute('data-name');

                deleteModal.querySelector('#productNameModal').textContent = productName;
                deleteModal.querySelector('#deleteProductIdInput').value = productId;
            });
        });
    </script>
}