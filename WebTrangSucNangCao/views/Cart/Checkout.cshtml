@model WebTrangSucNangCao.Models.CheckoutViewModel
@{
    // Xài ViewData chứ đéo xài ViewBag
    ViewData["Title"] = "Thanh Toán";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2>Thanh Toán</h2>
    <hr />
    <div class="row">
        <div class="col-md-7">
            <h4>Thông tin giao hàng</h4>

            <form asp-controller="Cart" asp-action="Checkout" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label>Họ và Tên</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Địa chỉ giao hàng</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <hr />
                <h5 class="mt-4">Phương thức thanh toán</h5>
                <div class="payment-options">
                    @* 1. Ship COD (mặc định) *@
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked onchange="toggleQR()">
                        <label class="form-check-label" for="cod">
                            Ship COD (Thanh toán khi nhận hàng)
                        </label>
                    </div>
                    @* 2. QR Code *@
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="qr" value="QR" onchange="toggleQR()">
                        <label class="form-check-label" for="qr">
                            Thanh toán bằng QR
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-checkout-custom w-100 mt-4">Xác nhận đặt hàng</button>
            </form>
        </div>

        <div class="col-md-5">
            <h4>Đơn hàng của bạn</h4>
            <table class="table">
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content(item.ImagePro)" style="width: 50px; height: 50px; object-fit: cover;" />
                            @item.NamePro <span class="text-muted">x @item.Quantity</span>
                        </td>
                        <td class="text-end">
                            @String.Format("{0:N0} VNĐ", item.Price * item.Quantity)
                        </td>
                    </tr>
                }
                <tr class="fw-bold">
                    <td>Tổng cộng</td>
                    <td class="text-end">@String.Format("{0:N0} VNĐ", Model.GrandTotal)</td>
                </tr>
                <tr id="qrCodeRow" style="display: none; transition: all 0.3s ease;">
                    <td colspan="2" class="text-center pt-3 pb-3 bg-light rounded border">
                        <div class="p-3 bg-white rounded shadow-sm d-inline-block w-100">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-qr-code-scan me-1"></i> Quét mã QR để chuyển khoản</h6>
                            @{
                                string bankBin = "970422"; 
                                string bankAccount = "0928023638";
                                string accountName = "PHAM VAN NGHIA";
                                string addInfo = "Thanh toan don hang Rosaria";
                                string qrUrl = $"https://img.vietqr.io/image/{bankBin}-{bankAccount}-compact2.png?amount={(long)Model.GrandTotal}&addInfo={Uri.EscapeDataString(addInfo)}&accountName={Uri.EscapeDataString(accountName)}";
                            }
                            <div class="my-2 text-center">
                                <img src="@qrUrl" alt="Mã QR Thanh Toán" style="max-width: 240px; width: 100%; height: auto; border: 1px solid #eee; border-radius: 8px; padding: 5px; background: #fff;" />
                            </div>
                            <div class="mt-2 small text-start px-2 bg-light p-2 rounded">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Ngân hàng:</span>
                                    <span class="fw-bold">MB Bank (970422)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Số tài khoản:</span>
                                    <span class="fw-bold text-primary">@bankAccount</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Chủ tài khoản:</span>
                                    <span class="fw-bold">@accountName</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Số tiền:</span>
                                    <span class="fw-bold text-danger">@String.Format("{0:N0} VNĐ", Model.GrandTotal)</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Nội dung:</span>
                                    <span class="fw-bold">@addInfo</span>
                                </div>
                            </div>
                            <div class="alert alert-warning py-2 px-2 mt-2 mb-0 small text-start d-flex align-items-center" style="font-size: 0.8rem;">
                                <i class="bi bi-info-circle-fill me-2 fs-5 text-warning"></i>
                                <span>Quét mã QR xong hoặc chuyển khoản thành công, vui lòng bấm <strong>"Xác nhận đặt hàng"</strong> bên dưới.</span>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleQR() {
            var qrRadio = document.getElementById("qr");
            var qrCodeRow = document.getElementById("qrCodeRow");
            if (qrCodeRow) {
                if (qrRadio && qrRadio.checked) {
                    qrCodeRow.style.display = "table-row";
                } else {
                    qrCodeRow.style.display = "none";
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleQR();
            var radios = document.querySelectorAll('input[name="paymentMethod"]');
            radios.forEach(function (radio) {
                radio.addEventListener("change", toggleQR);
            });
        });
    </script>
}