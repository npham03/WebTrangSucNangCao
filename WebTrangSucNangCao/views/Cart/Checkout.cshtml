@model WebTrangSucNangCao.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh Toán";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2>Thanh Toán</h2>
    <hr />
    <div class="row text-dark">
        <!-- BÊN TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN -->
        <div class="col-md-7">
            <h4 class="mb-3">Thông tin giao hàng</h4>

            <form asp-controller="Cart" asp-action="Checkout" method="post" id="checkoutForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Họ và Tên</label>
                    <!-- DÒNG SỬA MỚI: -->
                    <input asp-for="Name" class="form-control" placeholder="Nhập họ và tên người nhận" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Nhập địa chỉ email để nhận thông báo đơn hàng" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <!-- ĐỊA CHỈ 3 CẤP -->
                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label class="fw-bold">Tỉnh/Thành phố</label>
                        <select asp-for="Province" id="Province" class="form-select">
                            <option value="">-- Chọn Tỉnh/Thành --</option>
                        </select>
                        <span asp-validation-for="Province" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label class="fw-bold">Quận/Huyện</label>
                        <select asp-for="District" id="District" class="form-select" disabled>
                            <option value="">-- Chọn Quận/Huyện --</option>
                        </select>
                        <span asp-validation-for="District" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label class="fw-bold">Phường/Xã</label>
                        <select asp-for="Ward" id="Ward" class="form-select" disabled>
                            <option value="">-- Chọn Phường/Xã --</option>
                        </select>
                        <span asp-validation-for="Ward" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Số nhà, tên đường cụ thể</label>
                    <input asp-for="StreetAddress" class="form-control" placeholder="Ví dụ: 123 Đường Lê Lợi" />
                    <span asp-validation-for="StreetAddress" class="text-danger"></span>
                </div>

                <hr />
                <h5 class="mt-4">Phương thức thanh toán</h5>
                <div class="payment-options">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked>
                        <label class="form-check-label fw-semibold" for="cod">
                            Ship COD (Thanh toán khi nhận hàng)
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="qr" value="QR">
                        <label class="form-check-label fw-semibold" for="qr">
                            Thanh toán bằng QR Code chuyển khoản nhanh
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4 py-3 fw-bold">Xác nhận đặt hàng</button>
            </form>
        </div>

        <!-- BÊN PHẢI: CHI TIẾT ĐƠN HÀNG, MÃ GIẢM GIÁ & TÍNH TIỀN -->
        <div class="col-md-5">
            <h4 class="mb-3">Đơn hàng của bạn</h4>
            <div class="card p-3 shadow-sm">
                <table class="table align-middle">
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td style="width: 70%;">
                                    <img src="@Url.Content(Url.NormalizeImagePath(item.ImagePro))" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;" />
                                    <span class="fw-semibold">@item.NamePro</span> 
                                    <span class="text-muted small">x @item.Quantity</span>
                                </td>
                                <td class="text-end fw-bold text-nowrap">
                                    @String.Format("{0:N0} VNĐ", item.Price * item.Quantity)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- PHẦN MÃ GIẢM GIÁ (COUPON) -->
                <div class="mb-3 mt-2">
                    <label class="fw-bold small text-muted mb-1">Mã giảm giá</label>
                    <div class="input-group">
                        <input type="text" id="couponInput" class="form-control" placeholder="Nhập mã (Ví dụ: ROSARIA10)" value="@Model.CouponCode" />
                        <button class="btn btn-outline-dark" type="button" id="applyCouponBtn">Áp dụng</button>
                    </div>
                    <div id="couponMessage" class="small mt-1 d-none"></div>
                </div>

                <hr />

                <!-- TÍNH TOÁN CHI TIẾT TIỀN HÀNG -->
                <div class="d-flex justify-content-between mb-2">
                    <span>Tạm tính:</span>
                    <!-- DÒNG SỬA MỚI: -->
                    <span class="fw-semibold" id="grandTotalText">@String.Format("{0:N0} VNĐ", Model.CartSubtotal)</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>Giảm giá:</span>
                    <span class="fw-semibold" id="discountText">- @String.Format("{0:N0} VNĐ", Model.DiscountAmount)</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Phí vận chuyển:</span>
                    <span class="fw-semibold" id="shippingFeeText">@String.Format("{0:N0} VNĐ", Model.ShippingFee)</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold fs-5 text-primary">Tổng thanh toán:</span>
                    <span class="fw-bold fs-5 text-danger" id="totalPaymentText">@String.Format("{0:N0} VNĐ", Model.TotalPayment)</span>
                </div>

                <!-- KHU VỰC QR CODE ĐỘNG (CHỈ HIỆN KHI CHỌN QR) -->
                <div id="qrCodeContainer" class="card-body p-3 bg-light rounded border text-center mt-3 d-none">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-qr-code-scan me-1"></i> Quét mã QR để chuyển khoản
                    </h6>
                    <div class="my-3">
                        <!-- Ảnh QR Code sẽ được JavaScript cập nhật động URL theo số tiền thanh toán thực tế -->
                        <img id="qrImage" src="" alt="Mã QR Thanh Toán" style="max-width: 240px; width: 100%; height: auto; border: 1px solid #eee; border-radius: 8px; padding: 8px; background: #fff;" />
                    </div>
                    <div class="small text-start px-2 bg-white p-3 rounded shadow-sm">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <span class="fw-bold">MB Bank</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tài khoản:</span>
                            <span class="fw-bold text-primary">0928023638</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <span class="fw-bold">PHAM VAN NGHIA</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tiền cần chuyển:</span>
                            <span class="fw-bold text-danger" id="qrAmountText">@String.Format("{0:N0} VNĐ", Model.TotalPayment)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung chuyển khoản:</span>
                            <span class="fw-bold">Thanh toan don hang Rosaria</span>
                        </div>
                    </div>
                    <div class="alert alert-warning py-2 px-2 mt-3 mb-0 small text-start d-flex align-items-start" style="font-size: 0.8rem;">
                        <i class="bi bi-info-circle-fill me-2 fs-5 text-warning mt-1"></i>
                        <span>Sau khi chuyển khoản thành công, hãy bấm nút <strong>"Xác nhận đặt hàng"</strong> để hoàn tất đơn hàng.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện jQuery dùng để thực hiện Ajax nhanh chóng -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Cấu hình tài khoản ngân hàng thụ hưởng
        const bankBin = "970422"; // MB Bank
        const bankAccount = "0928023638";
        const accountName = "PHAM VAN NGHIA";
        const addInfo = "Thanh toan don hang Rosaria";

        // Biến lưu giữ giá trị tính toán cục bộ
        // DÒNG SỬA MỚI:
        let grandTotal = @Model.CartSubtotal;
        let discountAmount = @Model.DiscountAmount;
        let shippingFee = @Model.ShippingFee;

        $(document).ready(function () {
            // --- 1. XỬ LÝ ĐỊA CHỈ 3 CẤP ---
            const provinceSelect = $('#Province');
            const districtSelect = $('#District');
            const wardSelect = $('#Ward');

            // Load danh sách Tỉnh/Thành
            $.getJSON('https://provinces.open-api.vn/api/p/', function (data) {
                $.each(data, function (index, province) {
                    provinceSelect.append(`<option value="${province.name}" data-code="${province.code}">${province.name}</option>`);
                });

                // Nếu Model đã có sẵn tỉnh thành (ví dụ đã điền trước đó)
                let selectedProvince = "@Model.Province";
                if(selectedProvince) {
                    provinceSelect.val(selectedProvince).trigger('change');
                }
            });

            // Khi chọn Tỉnh/Thành -> Load Quận/Huyện & Tính phí ship mới
            provinceSelect.change(function () {
                const selectedOption = $(this).find('option:selected');
                const provinceCode = selectedOption.data('code');
                const provinceName = selectedOption.val();

                districtSelect.empty().append('<option value="">-- Chọn Quận/Huyện --</option>').prop('disabled', true);
                wardSelect.empty().append('<option value="">-- Chọn Phường/Xã --</option>').prop('disabled', true);

                if (provinceCode) {
                    // Gọi API provinces lấy danh sách Quận Huyện
                    $.getJSON(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`, function (data) {
                        $.each(data.districts, function (index, district) {
                            districtSelect.append(`<option value="${district.name}" data-code="${district.code}">${district.name}</option>`);
                        });
                        districtSelect.prop('disabled', false);

                        let selectedDistrict = "@Model.District";
                        if(selectedDistrict && provinceSelect.val() === "@Model.Province") {
                            districtSelect.val(selectedDistrict).trigger('change');
                        }
                    });

                    // Gọi API của hệ thống để cập nhật phí vận chuyển theo tỉnh thành mới
                    updateShippingFee(provinceName);
                } else {
                    updateShippingFee("");
                }
            });

            // Khi chọn Quận/Huyện -> Load Phường/Xã
            districtSelect.change(function () {
                const selectedOption = $(this).find('option:selected');
                const districtCode = selectedOption.data('code');

                wardSelect.empty().append('<option value="">-- Chọn Phường/Xã --</option>').prop('disabled', true);

                if (districtCode) {
                    $.getJSON(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`, function (data) {
                        $.each(data.wards, function (index, ward) {
                            wardSelect.append(`<option value="${ward.name}">${ward.name}</option>`);
                        });
                        wardSelect.prop('disabled', false);

                        let selectedWard = "@Model.Ward";
                        if(selectedWard && districtSelect.val() === "@Model.District") {
                            wardSelect.val(selectedWard);
                        }
                    });
                }
            });


            // --- 2. XỬ LÝ MÃ GIẢM GIÁ (COUPON) ---
            $('#applyCouponBtn').click(function () {
                const code = $('#couponInput').val();
                const msgDiv = $('#couponMessage');

                $.ajax({
                    url: '/Cart/ApplyCoupon',
                    type: 'POST',
                    data: { couponCode: code },
                    success: function (res) {
                        if (res.success) {
                            discountAmount = res.discountAmount;
                            msgDiv.removeClass('d-none text-danger').addClass('text-success').text(res.message);
                        } else {
                            discountAmount = 0;
                            msgDiv.removeClass('d-none text-success').addClass('text-danger').text(res.message);
                        }
                        updateSummaryUI();
                    },
                    error: function () {
                        msgDiv.removeClass('d-none text-success').addClass('text-danger').text("Lỗi kết nối máy chủ khi áp dụng mã.");
                    }
                });
            });


            // --- 3. XỬ LÝ TỔNG HỢP & HIỂN THỊ HÌNH THỨC THANH TOÁN ---
            function updateShippingFee(provinceName) {
                $.ajax({
                    url: '/Cart/GetShippingFee',
                    type: 'GET',
                    data: { province: provinceName },
                    success: function (res) {
                        shippingFee = res.shippingFee;
                        updateSummaryUI();
                    }
                });
            }

            function updateSummaryUI() {
                // Tính toán tổng thanh toán cuối cùng
                const totalPayment = Math.max(0, grandTotal - discountAmount + shippingFee);

                // Cập nhật text hiển thị đơn hàng
                $('#discountText').text(`- ${discountAmount.toLocaleString('vi-VN')} VNĐ`);
                $('#shippingFeeText').text(`${shippingFee.toLocaleString('vi-VN')} VNĐ`);
                $('#totalPaymentText').text(`${totalPayment.toLocaleString('vi-VN')} VNĐ`);
                $('#qrAmountText').text(`${totalPayment.toLocaleString('vi-VN')} VNĐ`);

                // Cập nhật lại Link QR code theo số tiền mới nhất
                const qrUrl = `https://img.vietqr.io/image/${bankBin}-${bankAccount}-compact2.png?amount=${Math.round(totalPayment)}&addInfo=${encodeURIComponent(addInfo)}&accountName=${encodeURIComponent(accountName)}`;
                $('#qrImage').attr('src', qrUrl);
            }

            function toggleQR() {
                const qrChecked = $('#qr').is(':checked');
                if (qrChecked) {
                    $('#qrCodeContainer').removeClass('d-none');
                } else {
                    $('#qrCodeContainer').addClass('d-none');
                }
            }

            // Gắn sự kiện thay đổi phương thức thanh toán
            $('input[name="paymentMethod"]').change(toggleQR);

            // Khởi chạy ban đầu để chuẩn hóa UI
            updateSummaryUI();
            toggleQR();
        });
    </script>
}