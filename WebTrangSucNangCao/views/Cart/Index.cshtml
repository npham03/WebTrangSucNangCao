@model IEnumerable<WebTrangSucNangCao.Models.CartItemViewModel>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "_Layout";
}

<div class="container mt-5 cart-page">
    <h2>GIỎ HÀNG</h2>

    @* ============================================================== *@
    @* ===              DASHBOARD MINI: TRẠNG THÁI ĐƠN HÀNG       === *@
    @* ============================================================== *@
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="card mb-5 shadow-sm border-0" style="background-color: #f8f9fa;">
            <div class="card-body py-3">
                <div class="row align-items-center">

                    @* TRƯỜNG HỢP 1: CÓ ĐƠN HÀNG ĐANG CHẠY *@
                    @if (ViewBag.OrderProductNames != null)
                    {
                        <div class="col-md-8">
                            <h6 class="text-uppercase text-muted small fw-bold mb-2">Đơn hàng đang thực hiện:</h6>
                            <div class="fw-bold text-dark text-truncate" style="font-size: 1.1rem;" title="@ViewBag.OrderProductNames">
                                <i class="fas fa-box-open me-2 text-primary"></i> @ViewBag.OrderProductNames
                            </div>
                            <div class="small text-muted mt-1">
                                Tổng số lượng: <strong>@ViewBag.OrderTotalQty</strong> sản phẩm
                            </div>
                        </div>

                        <div class="col-md-4 text-end">
                            <div class="mb-2">
                                Trạng thái:
                                <span class="badge rounded-pill @(ViewBag.OrderStatus == "Đang giao" ? "bg-dark text-white" : "bg-info text-dark")">
                                    @ViewBag.OrderStatus
                                </span>
                            </div>
                            <a asp-controller="Manage" asp-action="MyOrders" class="btn btn-sm btn-outline-dark rounded-pill">
                                Xem lịch sử đơn hàng
                            </a>
                        </div>
                    }
                    @* TRƯỜNG HỢP 2: KHÔNG CÓ ĐƠN ĐANG CHẠY *@
                    else
                    {
                        <div class="col-md-8">
                            <div class="d-flex align-items-center text-muted">
                                <div>
                                    <span class="fw-bold text-dark">Xin chào, @User.Identity.Name</span>
                                    <div class="small">Hiện tại không có đơn hàng nào đang xử lý.</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 text-end">
                            <a asp-controller="Manage" asp-action="MyOrders" class="btn btn-sm btn-outline-dark rounded-pill">
                                Xem lịch sử đơn hàng
                            </a>
                        </div>
                    }

                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        @* MÃ GIỎ HÀNG RỖNG *@
        <div class="empty-cart-container text-center mt-5">

            <img src="~/images/giohangtrong.png" alt="Giỏ hàng trống" style="max-width:300px;" />
            <p class="mt-3 fs-5">Không có sản phẩm nào trong giỏ hàng của bạn</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark btn-continue-shopping mt-2">
                TIẾP TỤC MUA HÀNG
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-header-row d-flex border-bottom pb-2 mb-3 fw-bold">
                    <div class="cart-header-product flex-grow-1">Sản phẩm</div>
                    <div class="cart-header-quantity" style="width: 150px; text-align:center;">Số lượng</div>
                    <div class="cart-header-total" style="width: 150px; text-align:end;">Tổng tiền</div>
                    <div class="cart-header-remove" style="width: 80px; text-align:center;">Xoá</div>
                </div>

                @foreach (var item in Model)
                {
                    var lineTotal = item.Price * item.Quantity;

                    <div class="cart-item-row d-flex align-items-center mb-3 pb-3 border-bottom" id="row-@item.VariantId">
                        <div class="cart-item-product flex-grow-1 d-flex align-items-center">
                            <img src="@Url.Content(item.ImagePro)" style="width: 80px; height: 80px; object-fit: cover; margin-right: 15px;" />
                            <div class="product-info-text">
                                <span class="d-block fw-bold">@item.NamePro</span>
                                <span class="d-block small text-muted">Size: @item.VariantName</span>
                                <span class="d-block text-danger">@String.Format("{0:N0}đ", item.Price)</span>
                            </div>
                        </div>

                        <div class="cart-item-quantity" style="width: 150px; text-align:center;">
                            <div class="input-group input-group-sm justify-content-center">
                                <button type="button" class="btn btn-outline-secondary btn-decrease" data-id="@item.VariantId">-</button>
                                <span class="input-group-text bg-white" id="quantity-@item.VariantId" style="width: 40px; justify-content:center;">@item.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary btn-increase" data-id="@item.VariantId">+</button>
                            </div>
                        </div>

                        <div class="cart-item-total fw-bold" id="linetotal-@item.VariantId" style="width: 150px; text-align:end;">
                            @String.Format("{0:N0}đ", lineTotal)
                        </div>

                        <div class="cart-item-remove" style="width: 80px; text-align:center;">
                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="m-0 p-0">
                                <input type="hidden" name="variantID" value="@item.VariantId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger btn-remove" style="border:none;">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-continue-shopping mt-2">
                    <i class="fas fa-arrow-left me-2"></i> TIẾP TỤC MUA HÀNG
                </a>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary-box border p-4 rounded bg-light">
                    <h5 class="mb-4">Tóm tắt đơn hàng</h5>
                    <div class="summary-row d-flex justify-content-between mb-3 fw-bold fs-5 border-top pt-3">
                        <span>Tổng tiền</span>
                        <span id="grandTotal" class="text-danger">
                            @String.Format("{0:N0}đ", Model.Sum(i => i.Price * i.Quantity))
                        </span>
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-dark btn-checkout w-100 py-2 text-uppercase fw-bold">
                        THANH TOÁN NGAY
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // LẮNG NGHE NÚT TĂNG (+)
            document.querySelectorAll('.btn-increase').forEach(button => {
                button.addEventListener('click', function () {
                    var variantId = this.getAttribute('data-id');
                    updateQuantity(variantId, '/Cart/IncreaseQuantity');
                });
            });

            // LẮNG NGHE NÚT GIẢM (-)
            document.querySelectorAll('.btn-decrease').forEach(button => {
                button.addEventListener('click', function () {
                    var variantId = this.getAttribute('data-id');
                    updateQuantity(variantId, '/Cart/DecreaseQuantity');
                });
            });

            // HÀM AJAX CHÍNH (Đã sửa để dùng chuẩn urlencode cho thẻ form)
            function updateQuantity(variantId, url) {
                // Tạo formData để gửi post request chuẩn xác
                var formData = new URLSearchParams();
                formData.append('variantID', variantId);

                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.json();
                })
                .then(data => {
                    if (data.deleted) {
                        document.getElementById('row-' + variantId).remove();
                        if (document.querySelectorAll('.cart-item-row').length === 0) {
                            window.location.reload();
                        }
                    } else {
                        document.getElementById('quantity-' + variantId).innerText = data.newQuantity;
                        document.getElementById('linetotal-' + variantId).innerText = formatCurrency(data.lineTotal) + 'đ';
                    }
                    document.getElementById('grandTotal').innerText = formatCurrency(data.grandTotal) + 'đ';
                })
                .catch(error => {
                    console.error('Lỗi khi cập nhật giỏ hàng:', error);
                    // Reload lại trang nếu AJAX tạch để tránh sai lệch data
                    window.location.reload();
                });
            }

            function formatCurrency(number) {
                return new Intl.NumberFormat('vi-VN').format(number);
            }

        });
    </script>
}