    @* Load Three.js + GLTFLoader rồi expose ra window cho ringTryOn.js (IIFE) *@
    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

        // Gắn vào window để ringTryOn.js (non-module) truy cập được
        // ES module namespace là frozen/read-only → dùng Proxy để wrap
        const extras = { GLTFLoader, RoomEnvironment };
        window.THREE = new Proxy(THREE, {
            get(target, prop) {
                return prop in extras ? extras[prop] : target[prop];
            }
        });

        // Load ringTryOn.js sau khi THREE sẵn sàng
        const s = document.createElement('script');
        s.src = '/js/ringTryOn.js?v=3';
        s.onload = function() {
            RingTryOn.init();

            document.getElementById('btnStartAR').addEventListener('click', function() {
                RingTryOn.start();
            });
            document.getElementById('btnStopAR').addEventListener('click', function() {
                RingTryOn.stop();
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    RingTryOn.stop();
                }
            });

            document.querySelectorAll('.ar-finger-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.ar-finger-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    RingTryOn.setFinger(this.getAttribute('data-finger'));
                });
            });

            var sizeSlider = document.getElementById('arSizeSlider');
            if (sizeSlider) {
                sizeSlider.addEventListener('input', function() {
                    RingTryOn.setScaleMultiplier(this.value);
                });
            }
        };
        s.onerror = function() {
            console.error('[RingTryOn] Không thể load ringTryOn.js');
            alert('Lỗi: Không thể tải module thử nhẫn 3D.');
        };
        document.body.appendChild(s);
    </script>
}