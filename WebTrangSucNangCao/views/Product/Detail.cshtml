@model WebTrangSucNangCao.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.NamePro;
    Layout = "_Layout";

    // Logic: Nếu chỉ có 1 size thì lấy luôn ID đó, còn nhiều size thì để null
    int? defaultVariantId = (Model.Variants != null && Model.Variants.Count == 1) ? Model.Variants[0].VariantId : (int?)null;
}

@* === CSS CHO TRANG NÀY === *@
<style>

    .product-detail-page {
        margin-top: 40px;
        margin-bottom: 70px;
    }
    .product-detail-page .col-md-7 {
        padding-left: 5px !important; 
    }

    .product-gallery {
        display: flex;
        gap: 8px;
    }

    .gallery-thumbnails {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .gallery-thumbnails img {
        width: 80px;
        height: 100px;
        object-fit: cover;
        cursor: pointer;
        border: 2px solid #eee;
        transition: border-color 0.3s;
    }

    .gallery-thumbnails img.active, .gallery-thumbnails img:hover {
        border-color: #000;
    }

    .gallery-main-image {
        flex-grow: 1;
    }

    .gallery-main-image img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1.2;
        object-fit: cover;
    }

    .product-detail-info .product-name {
        font-size: 2rem;
        font-weight: 600;
    }

    .product-detail-info .product-price {
        font-size: 1.5rem;
        color: #555;
        margin-bottom: 20px;
    }

    .variant-selector {
        margin-bottom: 25px;
    }

    .variant-selector label {
        font-weight: 600;
        margin-bottom: 10px;
        display: block;
    }

    .variant-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .variant-button {
        padding: 8px 15px;
        border: 2px solid #ccc;
        background: #fff;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
    }

    .variant-button:hover {
        border-color: #000;
    }

    .variant-button.active {
        background: #000;
        color: #fff;
        border-color: #000;
    }

    .variant-button:disabled {
        background: #f5f5f5;
        color: #aaa;
        border-color: #eee;
        cursor: not-allowed;
    }

    /* Nút bấm */
    .btn-add-to-cart {
        width: 100%;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        border-radius: 50px !important;
        margin-bottom: 15px;
        transition: all 0.3s;
    }

    .btn-add-to-cart:hover {
        background: #eee;
    }

    .btn-buy-now {
        width: 100%;
        background: #000;
        color: #fff;
        border: 2px solid #000;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        border-radius: 50px !important;
        margin-bottom: 15px;
        transition: all 0.3s;
    }

    .btn-buy-now:hover {
        background: #333;
        color: #fff;
    }

    #error-message {
        color: red;
        font-weight: 500;
        display: none;
    }

    .product-long-description {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid #eee;
    }

    .product-long-description h4 {
        font-weight: 600;
        margin-bottom: 15px;
    }

    .related-products {
        margin-top: 60px;
        margin-bottom: 30px;
        padding-top: 30px;
        border-top: 1px solid #eee;
    }

    /* CSS cho nút trong Modal (Hoán đổi màu) */
    .modal-footer-swappable .btn-modal-white {
        background-color: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 50px !important;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .modal-footer-swappable .btn-modal-black {
        background-color: #000;
        color: #fff;
        border: 2px solid #000;
        border-radius: 50px !important;
        padding: 10px 20px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .modal-footer-swappable .btn-modal-white:hover {
        background-color: #000;
        color: #fff;
    }

    /* === AR 3D TRY-ON STYLES === */
    .btn-ar-tryon {
        width: 100%;
        margin-top: 10px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: #fff;
        border: 2px solid transparent;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        border-radius: 50px !important;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }
    .btn-ar-tryon::before {
        content: '';
        position: absolute;
        top: 0; left: -100%; width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        transition: left 0.5s;
    }
    .btn-ar-tryon:hover::before { left: 100%; }
    .btn-ar-tryon:hover {
        background: linear-gradient(135deg, #0f3460 0%, #16213e 50%, #1a1a2e 100%);
        color: #fff;
        box-shadow: 0 4px 20px rgba(15,52,96,0.4);
    }

    /* === FULLSCREEN AR POPUP MODAL === */
    #arCameraContainer {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1000000;
        background: #09090b;
        display: none;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    #arMediaWrapper {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        overflow: hidden;
    }
    #arVideo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scaleX(-1);
        display: block;
    }
    #arOverlayContainer {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none;
        z-index: 5;
    }

    /* Top bar trong popup */
    .ar-topbar {
        position: absolute;
        top: 0; left: 0; right: 0;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(180deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 100%);
        z-index: 25;
        pointer-events: none;
    }
    .ar-topbar__info {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #fff;
        pointer-events: auto;
    }
    .ar-topbar__badge {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.28);
        backdrop-filter: blur(8px);
    }
    .ar-topbar__title {
        font-size: 16px;
        font-weight: 600;
        text-shadow: 0 1px 6px rgba(0,0,0,0.5);
    }

    /* Close button */
    .ar-close-btn {
        pointer-events: auto;
        width: 44px; height: 44px;
        border-radius: 50%;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.28);
        color: #fff;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
        backdrop-filter: blur(10px);
    }
    .ar-close-btn:hover {
        background: #dc3545;
        border-color: #dc3545;
        transform: scale(1.08);
    }

    /* Bottom HUD bar */
    .ar-bottom-bar {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 25;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: min(92vw, 620px);
        pointer-events: none;
    }
    .ar-controls-panel {
        pointer-events: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(15, 15, 20, 0.72);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(12px);
        color: #fff;
    }
    .ar-finger-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .ar-finger-btn {
        border: 1px solid rgba(255,255,255,0.25);
        background: transparent;
        color: rgba(255,255,255,0.85);
        font-size: 12px;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .ar-finger-btn:hover {
        border-color: #fff;
        color: #fff;
    }
    .ar-finger-btn.active {
        background: #fff;
        color: #000;
        border-color: #fff;
    }
    .ar-size-control {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 500;
    }
    .ar-size-control input[type="range"] {
        width: 110px;
        accent-color: #fff;
        cursor: pointer;
    }

    /* Loading spinner */
    .ar-loading {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.65);
        z-index: 30;
        flex-direction: column;
        gap: 12px;
    }
    .ar-loading__spinner {
        width: 48px; height: 48px;
        border: 4px solid rgba(255,255,255,0.2);
        border-top-color: #fff;
        border-radius: 50%;
        animation: arSpin 0.8s linear infinite;
    }
    .ar-loading__text {
        color: #fff;
        font-size: 14px;
        font-weight: 500;
    }
    @@keyframes arSpin {
        to { transform: rotate(360deg); }
    }

    /* Status pill */
    .ar-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
    }
    .ar-status--loading {
        background: rgba(255,193,7,0.9);
        color: #000;
    }
    .ar-status--ready {
        background: rgba(0,0,0,0.65);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
    }
    .ar-status--success {
        background: rgba(40,167,69,0.9);
        color: #fff;
    }
    .ar-status--error {
        background: rgba(220,53,69,0.9);
        color: #fff;
    }

    /* Toast notification */
    .ar-toast {
        position: fixed;
        top: 20px; right: 20px;
        max-width: 400px;
        padding: 14px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        z-index: 1000005;
        transform: translateX(120%);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .ar-toast--visible {
        transform: translateX(0);
    }
    .ar-toast--error {
        background: #dc3545;
        color: #fff;
    }
    .ar-toast--info {
        background: #17a2b8;
        color: #fff;
    }

</style>



<div class="container product-detail-page">
    <div class="row">

        <div class="col-md-7">
            <div class="product-gallery">
                <div class="gallery-thumbnails">
                    @* SỬA LỖI XUỐNG DÒNG VÀ ĐỊNH DẠNG RAZOR Ở ĐÂY *@
                    @if (Model.Images != null)
                    {
                        foreach (var img in Model.Images)
                        {
                            <img src="@Url.Content(Url.NormalizeImagePath(img.ImagePath))" onclick="changeMainImage(this)" />
                        }
                    }
                </div>
                <div class="gallery-main-image">
                    <img id="mainProductImage" src="@Url.Content(Url.NormalizeImagePath(Model.Product.ImagePro))" />
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="product-detail-info">
                <h2 class="product-name">@Model.Product.NamePro</h2>
                <p class="product-price">@String.Format("{0:N0} VNĐ", Model.Product.Price)</p>

                @if (Model.Variants != null && Model.Variants.Count == 1)
                {
                    // TRƯỜNG HỢP 1: CHỈ CÓ 1 SIZE -> TỰ CHỌN LUÔN
                    var onlyVariant = Model.Variants[0];
                    <input type="hidden" class="selected-variant-input" value="@onlyVariant.VariantId" />
                    <div class="mb-4">
                        <p class="mb-1">
                            <strong>Tình trạng:</strong>
                            <span class="@(onlyVariant.Stock > 0 ? "text-success" : "text-danger")">
                                @(onlyVariant.Stock > 0 ? "Còn hàng" : "Hết hàng")
                            </span>
                        </p>
                    </div>
                }
                else
                {
                    // TRƯỜNG HỢP 2: NHIỀU SIZE -> HIỆN NÚT CHỌN
                    <div class="variant-selector">
                        <label>Chọn Size:</label>
                        <div class="variant-options" id="variantContainer">
                            @if (Model.Variants != null)
                            {
                                foreach (var variant in Model.Variants)
                                {
                                    <button type="button"
                                            class="variant-button"
                                            data-variant-id="@variant.VariantId"
                                            @(variant.Stock <= 0 ? "disabled" : "")>
                                        @variant.VariantName
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }

                <p id="error-message">Vui lòng chọn 1 size</p>

                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="cart-form" id="addToCartForm">
                    <input type="hidden" name="variantID" value="@defaultVariantId" class="selected-variant-input" />
                    <button type="submit" class="btn btn-add-to-cart">THÊM VÀO GIỎ</button>
                </form>

                <form asp-controller="Cart" asp-action="BuyNow" method="post" class="cart-form">
                    <input type="hidden" name="variantId" value="@defaultVariantId" class="selected-variant-input" />
                    <button type="submit" class="btn btn-buy-now">MUA NGAY</button>
                </form>
                <button type="button" class="btn btn-ar-tryon" id="btnStartAR">
                    <i class="fas fa-camera me-2"></i> THỬ NHẪN QUA CAMERA
                </button>

                @* === AR 3D TRY-ON FULLSCREEN POPUP === *@
                <div id="arCameraContainer" style="display: none;">
                    <div id="arMediaWrapper">
                        <video id="arVideo" autoplay playsinline></video>
                        <div id="arOverlayContainer"></div>
                    </div>

                    @* Top Bar *@
                    <div class="ar-topbar">
                        <div class="ar-topbar__info">
                            <span class="ar-topbar__badge">AR 3D Try-On</span>
                            <span class="ar-topbar__title">@Model.Product.NamePro</span>
                        </div>
                        <button type="button" id="btnStopAR" class="ar-close-btn" title="??ng (Esc)">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    @* Loading overlay *@
                    <div id="arLoading" class="ar-loading">
                        <div class="ar-loading__spinner"></div>
                        <div class="ar-loading__text">?ang t?i model 3D...</div>
                    </div>

                    @* Bottom HUD *@
                    <div class="ar-bottom-bar">
                        <div id="arStatus" class="ar-status" style="display:none;"></div>
                        <div class="ar-controls-panel">
                            <div class="ar-finger-group">
                                <button type="button" class="ar-finger-btn active" data-finger="index">Ng?n tr?</button>
                                <button type="button" class="ar-finger-btn" data-finger="middle">Ng?n gi?a</button>
                                <button type="button" class="ar-finger-btn" data-finger="ring">Ng?n ?p ?t</button>
                            </div>
                            <div class="ar-size-control">
                                <span>C? nh?n:</span>
                                <input type="range" id="arSizeSlider" min="0.32" max="0.58" step="0.01" value="0.43" />
                            </div>
                        </div>
                    </div>
                </div>

                @* Toast notification (fixed position) *@
                <div id="arToast" class="ar-toast"></div>

                <div class="product-description-short">
                    <h4>Mô tả</h4>
                    <p>@Html.Raw(Model.Product.DecriptionPro != null ? Model.Product.DecriptionPro.Replace("\n", "<br />") : "")</p>
                    <h4>Chất liệu</h4>
                    <p>@Model.Product.Material</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="related-products">
                <h2 class="text-center product-title">CÁC SẢN PHẨM KHÁC</h2>
                <div class="row gy-4">
                    @if (Model.RelatedProducts != null)
                    {
                        foreach (var product in Model.RelatedProducts)
                        {
                            <div class="col-md-3">
                                <a href="@Url.Action("Detail", "Product", new { id = product.ProductId })" class="product-card-link">
                                    <div class="product-card">
                                        <img src="@Url.Content(Url.NormalizeImagePath(product.ImagePro ?? "~/images/placeholder.png"))" class="product-image" alt="@product.NamePro">
                                        <div class="product-info">
                                            <h5 class="product-name">@product.NamePro</h5>
                                            <p class="product-price">@String.Format("{0:N0} VNĐ", product.Price)</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* === HTML MODAL THÔNG BÁO === *@
<div class="modal fade" id="addedToCartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 0; border: 1px solid #000;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-check-circle" style="color: green;"></i> ĐÃ THÊM VÀO GIỎ HÀNG
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-3 align-items-center">
                    <div style="width: 80px; height: 80px; flex-shrink: 0;">
                        <img id="modalProductImg" src="" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" />
                    </div>
                    <div>
                        <h6 id="modalProductName" class="mb-1 fw-bold" style="font-family: 'Montserrat', sans-serif;"></h6>
                        <p class="mb-0 text-muted small">Số lượng trong giỏ: <span id="modalCartQty" class="fw-bold text-dark"></span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex modal-footer-swappable p-3">
                <button type="button" class="btn-modal-white" data-bs-dismiss="modal">Tiếp tục mua sắm</button>
                <a href="@Url.Action("Index", "Cart")" class="btn-modal-black">Xem giỏ hàng</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Đổi ảnh Gallery
        function changeMainImage(thumbnail) {
            var mainImage = document.getElementById('mainProductImage');
            mainImage.src = thumbnail.src;
            document.querySelectorAll('.gallery-thumbnails img').forEach(img => img.classList.remove('active'));
            thumbnail.classList.add('active');
        }

        document.addEventListener("DOMContentLoaded", function () {
            var firstThumbnail = document.querySelector('.gallery-thumbnails img');
            if (firstThumbnail) firstThumbnail.classList.add('active');

            var variantContainer = document.getElementById('variantContainer');
            var variantInputs = document.querySelectorAll('.selected-variant-input');
            var errorMessage = document.getElementById('error-message');

            // 2. Xử lý chọn Size
            if (variantContainer) {
                variantContainer.addEventListener('click', function (e) {
                    if (e.target.classList.contains('variant-button')) {
                        var clickedButton = e.target;
                        var variantId = clickedButton.getAttribute('data-variant-id');

                        variantContainer.querySelectorAll('.variant-button').forEach(btn => btn.classList.remove('active'));
                        clickedButton.classList.add('active');

                        variantInputs.forEach(input => input.value = variantId);
                        errorMessage.style.display = 'none';
                    }
                });
            }

            // 3. Tự động điền ID nếu đã có sẵn (trường hợp 1 size)
            var preFilledInput = document.querySelector('.selected-variant-input');
            if (preFilledInput && preFilledInput.value !== "") {
                variantInputs.forEach(input => input.value = preFilledInput.value);
                if (errorMessage) errorMessage.style.display = 'none';
            }

            // 4. Xử lý Submit Form
            var addToCartForm = document.getElementById('addToCartForm');
            if (addToCartForm) {
                addToCartForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    var hiddenInput = this.querySelector('.selected-variant-input');
                    if (hiddenInput.value === "") {
                        errorMessage.style.display = 'block';
                        return;
                    }

                    var formData = new FormData(this);
                    fetch(this.action, {
                        method: 'POST',
                        body: formData
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                document.getElementById('modalProductName').innerText = data.productName;
                                document.getElementById('modalCartQty').innerText = data.quantity;
                                var cleanPath = (data.productImage || '/images/placeholder.png').replace('~', '');
                                document.getElementById('modalProductImg').src = cleanPath;
                                var myModal = new bootstrap.Modal(document.getElementById('addedToCartModal'));
                                myModal.show();
                            } else {
                                alert("Lỗi! Vui lòng thử lại.");
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            }

            // Xử lý form Mua Ngay
            document.querySelectorAll('.cart-form').forEach(form => {
                if (form.id !== 'addToCartForm') {
                    form.addEventListener('submit', function (e) {
                        var hiddenInput = this.querySelector('.selected-variant-input');
                        if (hiddenInput.value === "") {
                            e.preventDefault();
                            errorMessage.style.display = 'block';
                        }
                    });
                }
            });
        });
    </script>

    @* === THƯ VIỆN BÊN NGOÀI === *@
    @* MediaPipe Hands + Camera Utils *@
    <script src="https://cdn.jsdelivr.net/npm/@@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

    @* Three.js importmap — bắt buộc để GLTFLoader resolve được 'three' *@
    @Html.Raw(@"<script type=""importmap"">
    {
        ""imports"": {
            ""three"": ""https://cdn.jsdelivr.net/npm/three@0.175.0/build/three.module.js"",
            ""three/addons/"": ""https://cdn.jsdelivr.net/npm/three@0.175.0/examples/jsm/""
        }
