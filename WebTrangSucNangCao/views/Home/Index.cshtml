@model WebTrangSucNangCao.Models.HomeViewModel
@{
    // Xài ViewData đéo xài ViewBag nữa
    ViewData["Title"] = "Trang Chủ";
    Layout = "_Layout";
}

@* === CSS GIỮ NGUYÊN ĐÉO ĐỤNG VÀO === *@
<style>
    #heroCarousel {
        width: 100%;
        height: 450px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .carousel-inner, .carousel-item {
        height: 100%;
    }

        .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

    @@media (max-width: 768px) {
        #heroCarousel {
            height: 250px;
        }
    }

    .filter-bar-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        margin-bottom: 40px;
        border-bottom: 2px solid #000;
        font-family: 'Montserrat', sans-serif;
    }

    .custom-dropdown-btn {
        background: none;
        border: none;
        font-weight: 600;
        font-size: 1.1rem;
        color: #000;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .custom-dropdown-btn:after {
            content: "▼";
            font-size: 0.6rem;
            margin-top: 2px;
        }

    .custom-dropdown-menu {
        border: none;
        border-radius: 12px;
        padding: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        min-width: 220px;
        margin-top: 10px;
    }

    .custom-dropdown-item {
        padding: 10px 15px;
        font-weight: 500;
        border-radius: 8px;
        color: #333;
        transition: all 0.2s;
        cursor: pointer;
        display: block;
        text-decoration: none;
    }

        .custom-dropdown-item:hover, .custom-dropdown-item.active {
            background-color: #000;
            color: #fff;
        }

    .sort-wrapper {
        border: 1px solid #ddd;
        padding: 5px 15px;
        border-radius: 4px;
        transition: all 0.3s;
    }

        .sort-wrapper:hover {
            border-color: #000;
        }

    .pagination-container {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .page-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid #eee;
        border-radius: 4px;
        color: #333;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s;
        background-color: #fff;
    }

        .page-btn:hover {
            border-color: #000;
            color: #000;
        }

        .page-btn.active {
            background-color: #000;
            color: #fff;
            border-color: #000;
        }

        .page-btn.disabled {
            color: #ccc;
            pointer-events: none;
            border-color: #f0f0f0;
        }
</style>

@* === PHẦN 1: SLIDER === *@
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-touch="true">

    <div class="carousel-indicators">
        @for (int i = 0; i < Model.Sliders.Count; i++)
        {
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                    class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
        }
    </div>

    <div class="carousel-inner">
        @for (int i = 0; i < Model.Sliders.Count; i++)
        {
            var slider = Model.Sliders[i];
            <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="4000">
                <a href="@(slider.Link ?? "#")">
                    <img src="@Url.Content(slider.ImagePath)" alt="@slider.Title" class="d-block w-100">
                </a>
            </div>
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>


@* === PHẦN 2: THANH LỌC & DANH SÁCH SẢN PHẨM === *@
<div class="container">
    <h2 class="text-center product-title" style="font-weight: 600; letter-spacing: 2px; margin-bottom: 30px;">TẤT CẢ SẢN PHẨM</h2>

    <form asp-controller="Home" asp-action="Index" method="get" id="filterForm">
        <input type="hidden" name="priceRange" id="inputPriceRange" value="@ViewBag.CurrentPrice" />
        <input type="hidden" name="sortOrder" id="inputSortOrder" value="@ViewBag.CurrentSort" />

        <div class="filter-bar-container">
            <div class="dropdown">
                <button class="custom-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @{
                        string priceLabel = "Lọc giá";
                        if (ViewBag.CurrentPrice == "1") { priceLabel = "0 - 499.000 VND"; }
                        else if (ViewBag.CurrentPrice == "2") { priceLabel = "500.000 - 999.000 VND"; }
                        else if (ViewBag.CurrentPrice == "3") { priceLabel = "1.000.000 - 1.499.000 VND"; }
                        else if (ViewBag.CurrentPrice == "4") { priceLabel = "1.500.000 - 1.999.000 VND"; }
                        else if (ViewBag.CurrentPrice == "5") { priceLabel = "Trên 2.000.000 VND"; }
                    }
                    @priceLabel
                </button>
                <ul class="dropdown-menu custom-dropdown-menu">
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '')">Tất cả</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '1')">0 - 499.000 VND</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '2')">500.000 - 999.000 VND</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '3')">1.000.000 - 1.499.000 VND</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '4')">1.500.000 - 1.999.000 VND</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('priceRange', '5')">Trên 2.000.000 VND</a></li>
                </ul>
            </div>

            <div class="dropdown">
                <button class="custom-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border: 1px solid #ddd; padding: 5px 15px; border-radius: 4px;">
                    @{
                        string sortLabel = "Thứ tự";
                        if (ViewBag.CurrentSort == "newest") { sortLabel = "Mới nhất"; }
                        else if (ViewBag.CurrentSort == "price_asc") { sortLabel = "Giá tăng dần"; }
                        else if (ViewBag.CurrentSort == "price_desc") { sortLabel = "Giá giảm dần"; }
                    }
                    @sortLabel
                </button>
                <ul class="dropdown-menu custom-dropdown-menu dropdown-menu-end">
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('sortOrder', 'newest')">Mới nhất</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('sortOrder', 'price_asc')">Giá tăng dần</a></li>
                    <li><a class="custom-dropdown-item" href="javascript:void(0);" onclick="submitFilter('sortOrder', 'price_desc')">Giá giảm dần</a></li>
                </ul>
            </div>
        </div>
    </form>

    <div class="product-grid">
        <div class="row gy-4">
            @foreach (var pvm in Model.Products)
            {
                <div class="col-md-3">
                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@pvm.Product.ProductId" class="product-card-link">
                        <div class="product-card">
                            <div class="product-image-wrapper">
                                <img src="@Url.Content(pvm.Product.ImagePro ?? "~/images/placeholder.png")" class="product-image img-main" alt="@pvm.Product.NamePro">

                                @if (pvm.HoverImage != null)
                                {
                                    <img src="@Url.Content(pvm.HoverImage)" class="product-image img-hover" alt="@pvm.Product.NamePro">
                                }
                            </div>
                            <div class="product-info">
                                <h5 class="product-name">@pvm.Product.NamePro</h5>
                                <p class="product-price">@String.Format("{0:N0} VNĐ", pvm.Product.Price)</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>

    @* === PHẦN HIỂN THỊ NÚT PHÂN TRANG (ĐÃ ĐỘ LẠI BẰNG TAG HELPER) === *@
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-container">
            @{
                int page = ViewBag.PageNumber;
                int totalPages = ViewBag.TotalPages;
            }

            @if (page > 1)
            {
                <a asp-controller="Home" asp-action="Index" asp-route-page="@(page - 1)" asp-route-priceRange="@ViewBag.CurrentPrice" asp-route-sortOrder="@ViewBag.CurrentSort" class="page-btn">«</a>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == 1 || i == totalPages || (i >= page - 1 && i <= page + 1))
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-page="@i" asp-route-priceRange="@ViewBag.CurrentPrice" asp-route-sortOrder="@ViewBag.CurrentSort"
                       class="page-btn @(i == page ? "active" : "")">@i</a>
                }
                else if (i == page - 2 || i == page + 2)
                {
                    <span class="page-btn disabled" style="border:none;">...</span>
                }
            }

            @if (page < totalPages)
            {
                <a asp-controller="Home" asp-action="Index" asp-route-page="@(page + 1)" asp-route-priceRange="@ViewBag.CurrentPrice" asp-route-sortOrder="@ViewBag.CurrentSort" class="page-btn">»</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // 1. Hàm xử lý Lọc
        function submitFilter(type, value) {
            if (type === 'priceRange') {
                document.getElementById('inputPriceRange').value = value;
            } else if (type === 'sortOrder') {
                document.getElementById('inputSortOrder').value = value;
            }
            document.getElementById('filterForm').submit();
        }

        // 2. HỖ TRỢ KÉO CHUỘT CHO SLIDER
        document.addEventListener('DOMContentLoaded', function () {
            const slider = document.getElementById('heroCarousel');
            if (slider) {
                let isDown = false;
                let startX;

                slider.addEventListener('mousedown', (e) => {
                    isDown = true;
                    startX = e.pageX;
                    slider.style.cursor = 'grabbing';
                });

                slider.addEventListener('mouseup', (e) => {
                    if (!isDown) return;
                    isDown = false;
                    slider.style.cursor = 'default';

                    const endX = e.pageX;
                    const diff = startX - endX;

                    var myCarousel = bootstrap.Carousel.getOrCreateInstance(slider);

                    if (Math.abs(diff) > 50) {
                        if (diff > 0) {
                            myCarousel.next();
                        } else {
                            myCarousel.prev();
                        }
                    }
                });

                slider.addEventListener('mouseleave', () => {
                    isDown = false;
                    slider.style.cursor = 'default';
                });

                slider.querySelectorAll('img').forEach(img => {
                    img.addEventListener('dragstart', (e) => e.preventDefault());
                });
            }
        });
    </script>
}