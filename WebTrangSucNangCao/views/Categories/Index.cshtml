@model IEnumerable<WebTrangSucNangCao.Models.Category>

@{
    // Xài ViewData đéo xài ViewBag
    ViewData["Title"] = "Category List";
    Layout = "_Layout";
}

<h2>Danh sách danh mục</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới danh mục</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NameCate</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>