@model WebTrangSucNangCao.Models.RegisterViewModel

<form asp-controller="Account" asp-action="Register" method="post" class="register-form-custom" role="form">
    <h4 class="text-center mb-4">ĐĂNG KÝ THÀNH VIÊN MỚI</h4>
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3 custom-input-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 custom-input-group">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 custom-input-group">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 custom-input-group">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 custom-input-group">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-4 custom-input-group">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-outline-dark w-100 btn-lg">Đăng ký</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}