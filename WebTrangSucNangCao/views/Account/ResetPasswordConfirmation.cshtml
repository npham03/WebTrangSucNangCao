@{
    ViewData["Title"] = "Reset password confirmation";
}

<main aria-labelledby="title">
    <hgroup class="title">
        <h1 id="title">@ViewData["Title"].</h1>
    </hgroup>
    <div>
        <p>
            Your password has been reset. Please
            <a asp-controller="Account" asp-action="Login" id="loginLink">click here to log in</a>
        </p>
    </div>
</main>