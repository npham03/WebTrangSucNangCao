@model WebTrangSucNangCao.Models.ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Register";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>
    <h3>Associate your @ViewData["LoginProvider"] account.</h3>

    <form asp-controller="Account" asp-action="ExternalLoginConfirmation" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">

        <h4>Association Form</h4>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <p class="text-info">
            You've successfully authenticated with <strong>@ViewData["LoginProvider"]</strong>.
            Please enter a user name for this site below and click the Register button to finish
            logging in.
        </p>

        <div class="row mb-3">
            <label asp-for="Email" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <button type="submit" class="btn btn-outline-dark">Register</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}