@model WebTrangSucNangCao.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"]</h2>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" role="form">
        <h4>Enter your email.</h4>
        <hr />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row mb-3">
            <label asp-for="Email" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <button type="submit" class="btn btn-outline-dark">Email Link</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}