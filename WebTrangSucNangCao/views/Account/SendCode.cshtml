@model WebTrangSucNangCao.Models.SendCodeViewModel
@{
    ViewData["Title"] = "Send";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>

    <form asp-controller="Account" asp-action="SendCode" asp-route-returnurl="@Model.ReturnUrl" method="post" role="form">

        <input type="hidden" asp-for="RememberMe" />

        <h4>Send verification code</h4>
        <hr />

        <div class="row">
            <div class="col-md-8">
                Select Two-Factor Authentication Provider:

                <select asp-for="SelectedProvider" asp-items="Model.Providers" class="form-control"></select>

                <button type="submit" class="btn btn-outline-dark mt-2">Submit</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}