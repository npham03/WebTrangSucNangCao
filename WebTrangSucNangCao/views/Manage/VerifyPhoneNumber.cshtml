@model WebTrangSucNangCao.Models.VerifyPhoneNumberViewModel
@{
    // Dùng ViewData thay cho ViewBag củ lồn
    ViewData["Title"] = "Verify Phone Number";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>

    <form asp-controller="Manage" asp-action="VerifyPhoneNumber" method="post" role="form">

        <input type="hidden" asp-for="PhoneNumber" />

        <h4>Enter verification code</h4>
        <h5>@ViewBag.Status</h5>
        <hr />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row mb-3">
            <label asp-for="Code" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <button type="submit" class="btn btn-outline-dark">Submit</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}