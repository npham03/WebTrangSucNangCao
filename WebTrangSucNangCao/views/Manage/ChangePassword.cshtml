@model WebTrangSucNangCao.Models.ChangePasswordViewModel
@{
    // Dùng ViewData thay cho ViewBag
    ViewData["Title"] = "Change Password";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>

    <form asp-controller="Manage" asp-action="ChangePassword" method="post" role="form">

        <h4>Change Password Form</h4>
        <hr />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row mb-3">
            <label asp-for="OldPassword" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="OldPassword" class="form-control" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="NewPassword" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="ConfirmPassword" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <button type="submit" class="btn btn-outline-dark">Change password</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}