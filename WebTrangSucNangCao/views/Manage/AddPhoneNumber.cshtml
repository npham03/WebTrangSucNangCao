@model WebTrangSucNangCao.Models.AddPhoneNumberViewModel
@{
    
    ViewData["Title"] = "Phone Number";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>

    <form asp-controller="Manage" asp-action="AddPhoneNumber" method="post" role="form">

        <h4>Add a phone number</h4>
        <hr />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row mb-3">
            <label asp-for="Number" class="col-md-2 col-form-label"></label>
            <div class="col-md-10">
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <button type="submit" class="btn btn-outline-dark">Submit</button>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}