@model WebTrangSucNangCao.Models.IndexViewModel
@{
    ViewData["Title"] = "Manage";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewData["Title"].</h2>

    <p class="text-success">@ViewBag.StatusMessage</p>
    <div>
        <h4>Change your account settings</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Password:</dt>
            <dd class="col-sm-8">
                [
                @if (Model.HasPassword)
                {
                    <a asp-controller="Manage" asp-action="ChangePassword">Change your password</a>
                }
                else
                {
                    <a asp-controller="Manage" asp-action="SetPassword">Create</a>
                }
                ]
            </dd>

            <dt class="col-sm-4">External Logins:</dt>
            <dd class="col-sm-8">
                @Model.Logins.Count [
                <a asp-controller="Manage" asp-action="ManageLogins">Manage</a> ]
            </dd>

            <dt class="col-sm-4">Two-Factor Authentication:</dt>
            <dd class="col-sm-8">
                <p>
                    There are no two-factor authentication providers configured. See <a href="https://go.microsoft.com/fwlink/?LinkId=403804">this article</a>
                    for details on setting up this ASP.NET application to support two-factor authentication.
                </p>
            </dd>
        </dl>
    </div>
</main>