@using Microsoft.AspNetCore.Identity
@using WebTrangSucNangCao.Models  
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Rosaria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/NavBar.css" asp-append-version="true" />
    <link rel="icon" href="~/images/rosa1.png" type="image/png">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>
    <!-- Page Transition Overlay -->
    <div id="pageTransitionOverlay" class="page-transition-overlay">
        <div class="spinner-border text-dark" style="width: 3rem; height: 3rem; border-width: 0.25em;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <style>
        .page-transition-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #ffffff;
            z-index: 999999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }
        .page-transition-overlay.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
    </style>

    <nav class="navbar" id="mainNavbar">

        <a asp-controller="Home" asp-action="Index" class="brand">
            <img src="~/images/rosa4.png" alt="Rosaria Logo" class="logo">
            <span class="brand-name">ROSARIA</span>
        </a>

        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Rings">@Localizer["RINGS"]</a></li>
            <li><a asp-controller="Home" asp-action="Bracelets">@Localizer["BRACELETS"]</a></li>
            <li><a asp-controller="Home" asp-action="Necklaces">@Localizer["NECKLACES"]</a></li>
            <li><a asp-controller="Home" asp-action="Earrings">@Localizer["EARRINGS"]</a></li>
        </ul>
        <div class="nav-right">
            <form asp-controller="Home" asp-action="Search" method="get" class="search-box">
                <input type="text" name="searchTerm" placeholder="@Localizer["SearchPlaceholder"]">
                <button type="submit" class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </form>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="user-menu-container">
                    <span class="user-icon-nav">
                        <img src="~/images/dangnhap.png" class="icon" alt="User Icon" />
                    </span>
                    <div class="user-dropdown">
                        <div class="username-display">
                            Hi, <strong>@User.Identity.Name</strong>
                        </div>
                        <hr style="margin: 8px 0;">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="login-register-link">Dashboard</a>
                            <hr style="margin: 8px 0;">
                        }

                        <form asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">Logout</a>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="user-menu-container">
                    <span class="user-icon-nav">
                        <img src="~/images/dangnhap.png" class="icon" alt="Login Icon" />
                    </span>
                    <div class="user-dropdown">
                        <a asp-controller="Account" asp-action="Login" class="login-register-link">Login</a>
                        <hr style="margin: 8px 0;">
                        <a asp-controller="Account" asp-action="Register" class="login-register-link">Register</a>
                    </div>
                </div>
            }

            <a asp-controller="Cart" asp-action="Index">
                <i>
                    <img src="~/images/giohang2.png" class="icon" alt="Cart Icon" />
                </i>
            </a>

            @using Microsoft.AspNetCore.Builder
            @using Microsoft.AspNetCore.Localization
            @using Microsoft.AspNetCore.Http.Features

            @{
                // Lấy thông tin ngôn ngữ hiện tại từ Request
                var requestCulture = Context.Features.Get<IRequestCultureFeature>();
                var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
            }

            <div class="lang-switch" style="display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 16px;">
                <form asp-controller="Language" asp-action="Change" method="post" id="langForm" style="display: none;">
                    <input type="hidden" name="culture" id="langCulture" value="" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                </form>
                
                <a href="javascript:void(0);" onclick="changeLanguageWithTransition('vi')" style="text-decoration: none; transition: color 0.2s; font-weight: @(currentCulture == "vi" ? "bold" : "normal"); color: @(currentCulture == "vi" ? "inherit" : "#888");">
                    Vie
                </a>
                <span style="color: #ccc; font-weight: normal; user-select: none;">|</span>
                <a href="javascript:void(0);" onclick="changeLanguageWithTransition('en')" style="text-decoration: none; transition: color 0.2s; font-weight: @(currentCulture == "en" ? "bold" : "normal"); color: @(currentCulture == "en" ? "inherit" : "#888");">
                    Eng
                </a>
            </div>
        </div>

    </nav>

    <div class="main-content-wrapper">
        @RenderBody()
    </div>

    <footer class="sit@* e-footer">
        <img src="~/images/foote *@r4.png" alt="Footer Bar" class="footer-top-bar-img" />

        <div class="footer-content">
            <div class="container">
                <div class="row align-items-center">

                    <div class="col-md-6 footer-column text-start">
                        <img src="~/images/rosa4.png" alt="Rosaria Logo" class="footer-logo" />
                        <p class="footer-tagline">
                            Fine jewelry inspired by the purity of nature.
                        </p>
                    </div>

                    <div class="col-md-6 footer-column text-end">
                        <div class="footer-contact-title">contact</div>
                        <a href="https://www.google.com/maps/search/?api=1&query=806,+National+Highway+22,+Tan+Xuan+Commune,+Hoc+Mon+District,+Ho+Chi+Minh+City"
                           target="_blank"
                           style="text-decoration: none; color: inherit;">
                            <p class="footer-address">
                                806, National Highway 22, Tan Xuan Commune, Hoc Mon District, Ho Chi Minh City
                            </p>
                        </a>
                        <div class="social-icons justify-content-end">
                            <a href="https://www.facebook.com/pham.nghia.723149" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                            <a href="https://www.instagram.com/vawnnghixa_" class="social-icon"><i class="fab fa-instagram"></i></a>
                            <a href="https://www.tiktok.com/%40phm.vngia" class="social-icon"><i class="fab fa-tiktok"></i></a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <img src="~/images/footer4.png" alt="Footer Bar" class="footer-top-bar-img" />
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const navbar = document.getElementById('mainNavbar') || document.querySelector('.navbar');
            const heroBanner = document.getElementById('heroCarousel');

            function updateNavbarState() {
                if (!navbar) return;
                if (heroBanner) {
                    navbar.classList.add('navbar-fixed-over-banner');
                    
                    const bannerHeight = heroBanner.offsetHeight;
                    const navbarHeight = navbar.offsetHeight || 60;
                    
                    // Nếu chưa cuộn qua hết banner -> trong suốt / đảo màu
                    if (window.scrollY < bannerHeight - navbarHeight) {
                        navbar.classList.add('nav-transparent');
                        navbar.classList.remove('nav-scrolled');
                    } else {
                        // Khi cuộn qua hết banner -> nền trắng chữ đen
                        navbar.classList.remove('nav-transparent');
                        navbar.classList.add('nav-scrolled');
                    }
                } else {
                    // Trang không có banner -> nền trắng chữ đen cố định (nav-scrolled)
                    navbar.classList.remove('navbar-fixed-over-banner', 'nav-transparent');
                    navbar.classList.add('nav-scrolled');
                }
            }

            window.addEventListener('scroll', updateNavbarState);
            window.addEventListener('resize', updateNavbarState);
            updateNavbarState();
        });

        // Tắt overlay khi DOM đã tải xong
        window.addEventListener('DOMContentLoaded', function () {
            const overlay = document.getElementById('pageTransitionOverlay');
            if (overlay) {
                overlay.classList.add('hidden');
            }
        });
        
        // Hàm chuyển ngôn ngữ có hiệu ứng mượt
        function changeLanguageWithTransition(culture) {
            const overlay = document.getElementById('pageTransitionOverlay');
            if (overlay) {
                overlay.classList.remove('hidden');
                setTimeout(() => {
                    document.getElementById('langCulture').value = culture;
                    document.getElementById('langForm').submit();
                }, 300); // Đợi 300ms cho màn hình mờ dần rồi mới submit trang
            } else {
                document.getElementById('langCulture').value = culture;
                document.getElementById('langForm').submit();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>