@using Microsoft.AspNetCore.Identity
@using WebTrangSucNangCao.Models  
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Rosaria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/NavBar.css" asp-append-version="true" />
    <link rel="icon" href="~/images/rosa1.png" type="image/png">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <nav class="navbar">

        <a asp-controller="Home" asp-action="Index" class="brand">
            <img src="~/images/rosa4.png" alt="Rosaria Logo" class="logo">
            <span class="brand-name">ROSARIA</span>
        </a>

        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Rings">RINGS</a></li>
            <li><a asp-controller="Home" asp-action="Bracelets">BRACELETS</a></li>
            <li><a asp-controller="Home" asp-action="Necklaces">NECKLACES</a></li>
            <li><a asp-controller="Home" asp-action="Earrings">EARRINGS</a></li>
        </ul>

        <div class="nav-right">
            <form asp-controller="Home" asp-action="Search" method="get" class="search-box">
                <input type="text" name="searchTerm" placeholder="Search...">
                <button type="submit" class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </form>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="user-menu-container">
                    <span class="user-icon-nav">
                        <img src="~/images/dangnhap.png" class="icon" alt="User Icon" />
                    </span>
                    <div class="user-dropdown">
                        <div class="username-display">
                            Hi, <strong>@User.Identity.Name</strong>
                        </div>
                        <hr style="margin: 8px 0;">

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="login-register-link">Thống kê và quản trị</a>
                            <a asp-controller="Admin" asp-action="ProductList" class="login-register-link">Quản lý Sản phẩm</a>
                            <a asp-controller="Admin" asp-action="Orders" class="login-register-link">Quản lý Đơn hàng</a>
                            <a asp-controller="Admin" asp-action="Users" class="login-register-link">Quản lý User</a>
                            <hr style="margin: 8px 0;">
                        }

                        <form asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">Logout</a>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="user-menu-container">
                    <span class="user-icon-nav">
                        <img src="~/images/dangnhap.png" class="icon" alt="Login Icon" />
                    </span>
                    <div class="user-dropdown">
                        <a asp-controller="Account" asp-action="Login" class="login-register-link">Login</a>
                        <hr style="margin: 8px 0;">
                        <a asp-controller="Account" asp-action="Register" class="login-register-link">Register</a>
                    </div>
                </div>
            }

            <a asp-controller="Cart" asp-action="Index">
                <i>
                    <img src="~/images/giohang2.png" class="icon" alt="Cart Icon" />
                </i>
            </a>

            <div class="lang-switch">
                <span>Vi</span>
            </div>
        </div>

    </nav>

    <div class="main-content-wrapper">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <img src="~/images/footer4.png" alt="Footer Bar" class="footer-top-bar-img" />

        <div class="footer-content">
            <div class="container">
                <div class="row align-items-center">

                    <div class="col-md-6 footer-column text-start">
                        <img src="~/images/rosa4.png" alt="Rosaria Logo" class="footer-logo" />
                        <p class="footer-tagline">
                            Fine jewelry inspired by the purity of nature.
                        </p>
                    </div>

                    <div class="col-md-6 footer-column text-end">
                        <div class="footer-contact-title">contact</div>
                        <a href="https://www.google.com/maps/search/?api=1&query=806,+National+Highway+22,+Tan+Xuan+Commune,+Hoc+Mon+District,+Ho+Chi+Minh+City"
                           target="_blank"
                           style="text-decoration: none; color: inherit;">
                            <p class="footer-address">
                                806, National Highway 22, Tan Xuan Commune, Hoc Mon District, Ho Chi Minh City
                            </p>
                        </a>
                        <div class="social-icons justify-content-end">
                            <a href="https://www.facebook.com/pham.nghia.723149" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                            <a href="https://www.instagram.com/vawnnghixa_" class="social-icon"><i class="fab fa-instagram"></i></a>
                            <a href="https://www.tiktok.com/%40phm.vngia" class="social-icon"><i class="fab fa-tiktok"></i></a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <img src="~/images/footer4.png" alt="Footer Bar" class="footer-top-bar-img" />
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>