@model WebTrangSucNangCao.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.NamePro;
    Layout = "_Layout";
}

@* === CSS GIỮ NGUYÊN === *@
<style>
    .product-detail-page {
        margin-top: 40px;
    }

    .product-gallery {
        display: flex;
        gap: 15px;
    }

    .gallery-thumbnails {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .gallery-thumbnails img {
            width: 80px;
            height: 100px;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid #eee;
            transition: border-color 0.3s;
        }

            .gallery-thumbnails img.active, .gallery-thumbnails img:hover {
                border-color: #000;
            }

    .gallery-main-image {
        flex-grow: 1;
    }

        .gallery-main-image img {
            width: 100%;
            height: auto;
            aspect-ratio: 1 / 1.2;
            object-fit: cover;
        }

    .product-detail-info .product-name {
        font-size: 2rem;
        font-weight: 600;
    }

    .product-detail-info .product-price {
        font-size: 1.5rem;
        color: #555;
        margin-bottom: 20px;
    }

    .variant-selector {
        margin-bottom: 25px;
    }

        .variant-selector label {
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
        }

    .variant-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .variant-button {
        padding: 8px 15px;
        border: 2px solid #ccc;
        background: #fff;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
    }

        .variant-button:hover {
            border-color: #000;
        }

        .variant-button.active {
            background: #000;
            color: #fff;
            border-color: #000;
        }

        .variant-button:disabled {
            background: #f5f5f5;
            color: #aaa;
            border-color: #eee;
            cursor: not-allowed;
        }

    .btn-add-to-cart {
        width: 100%;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        border-radius: 50px !important;
        margin-bottom: 15px;
        transition: all 0.3s;
    }

        .btn-add-to-cart:hover {
            background: #eee;
        }

    .btn-buy-now {
        width: 100%;
        background: #000;
        color: #fff;
        border: 2px solid #000;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        border-radius: 50px !important;
        margin-bottom: 15px;
        transition: all 0.3s;
    }

        .btn-buy-now:hover {
            background: #333;
            color: #fff;
        }

    #error-message {
        color: red;
        font-weight: 500;
        display: none;
    }

    .product-long-description {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid #eee;
    }

        .product-long-description h4 {
            font-weight: 600;
            margin-bottom: 15px;
        }

    .related-products {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid #eee;
    }
</style>

<div class="container product-detail-page">
    <div class="row">

        <div class="col-md-7">
            <div class="product-gallery">
                <div class="gallery-thumbnails">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@Url.Content(Url.NormalizeImagePath(img.ImagePath))" onclick="changeMainImage(this)" />
                    }
                </div>
                <div class="gallery-main-image">
                    <img id="mainProductImage" src="@Url.Content(Url.NormalizeImagePath(Model.Product.ImagePro))" />
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="product-detail-info">

                <h2 class="product-name">@Model.Product.NamePro</h2>
                <p class="product-price">@String.Format("{0:N0} VNĐ", Model.Product.Price)</p>

                <div class="variant-selector">
                    <label>Chọn Size:</label>
                    <div class="variant-options" id="variantContainer">
                        @foreach (var variant in Model.Variants)
                        {
                            <button type="button"
                                    class="variant-button"
                                    data-variant-id="@variant.VariantId"
                                @(variant.Stock <= 0 ? "disabled" : "")>
                                @variant.VariantName
                            </button>
                        }
                    </div>
                </div>

                <p id="error-message">Vui lòng chọn 1 size</p>

                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="cart-form">
                    <input type="hidden" name="variantID" value="" class="selected-variant-input" />
                    <button type="submit" class="btn btn-add-to-cart">
                        THÊM VÀO GIỎ
                    </button>
                </form>

                <form asp-controller="Cart" asp-action="BuyNow" method="post" class="cart-form">
                    <input type="hidden" name="variantID" value="" class="selected-variant-input" />
                    <button type="submit" class="btn btn-buy-now">
                        MUA NGAY
                    </button>
                </form>

                <div class="product-description-short">
                    <h4>Mô tả</h4>
                    <p>@Html.Raw(Model.Product.DecriptionPro.Replace("\n", "<br />"))</p>
                    <h4>Chất liệu</h4>
                    <p>@Model.Product.Material</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="related-products">
                <h2 class="text-center product-title">CÁC SẢN PHẨM KHÁC</h2>
                <div class="row gy-4">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        <div class="col-md-3">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.ProductId" class="product-card-link">
                                <div class="product-card">
                                    <img src="@Url.Content(product.ImagePro ?? "~/images/placeholder.png")" class="product-image" alt="@product.NamePro">
                                    <div class="product-info">
                                        <h5 class="product-name">@product.NamePro</h5>
                                        <p class="product-price">@String.Format("{0:N0} VNĐ", product.Price)</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // === 1. Xử lý đổi ảnh Gallery ===
        function changeMainImage(thumbnail) {
            var mainImage = document.getElementById('mainProductImage');
            mainImage.src = thumbnail.src;
            document.querySelectorAll('.gallery-thumbnails img').forEach(img => img.classList.remove('active'));
            thumbnail.classList.add('active');
        }

        document.addEventListener("DOMContentLoaded", function () {
             var firstThumbnail = document.querySelector('.gallery-thumbnails img');
             if(firstThumbnail) {
                 firstThumbnail.classList.add('active');
             }

            // === 2. Xử lý chọn Size (Variant) ===
            var variantContainer = document.getElementById('variantContainer');
            var variantInputs = document.querySelectorAll('.selected-variant-input'); // Lấy TẤT CẢ input ẩn
            var errorMessage = document.getElementById('error-message');

            variantContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('variant-button')) {
                    var clickedButton = e.target;
                    var variantId = clickedButton.getAttribute('data-variant-id');

                    // Bỏ active nút khác
                    variantContainer.querySelectorAll('.variant-button').forEach(btn => btn.classList.remove('active'));
                    // Active nút m bấm
                    clickedButton.classList.add('active');

                    // CẬP NHẬT CẢ 2 INPUT ẨN
                    variantInputs.forEach(input => input.value = variantId);

                    errorMessage.style.display = 'none'; // Ẩn lỗi
                }
            });

            // === 3. Xử lý Submit (Kiểm tra xem m đã chọn size chưa) ===
            document.querySelectorAll('.cart-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    // Lấy input ẩn CỦA CHÍNH FORM NÀY
                    var hiddenInput = form.querySelector('.selected-variant-input');
                    if (hiddenInput.value === "") {
                        e.preventDefault(); // CHẶN
                        errorMessage.style.display = 'block'; // Hiện lỗi
                    }
                });
            });
        });
    </script>
}